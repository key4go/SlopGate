{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/stop-check.mjs",
            "timeout": 30,
            "statusMessage": "SlopGate is checking the diff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/git-guard.mjs",
            "timeout": 30,
            "statusMessage": "SlopGate is checking git safety"
          }
        ]
      }
    ]
  }
}
